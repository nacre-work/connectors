{
  "name": "nacre-connectors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm lint:cla && pnpm lint:config && pnpm lint:core-pin && pnpm lint:formats && pnpm lint:images && pnpm lint:workflows",
    "lint:cla": "node scripts/check-cla-copy.mjs",
    "lint:config": "node scripts/check-config.mjs",
    "lint:core-pin": "node scripts/check-core-pin.mjs",
    "lint:formats": "node scripts/check-formats.mjs",
    "lint:images": "node scripts/check-images.mjs",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
